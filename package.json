{
  "name": "@piphi-network/cli",
  "version": "0.3.0",
  "description": "Create, validate, test, and maintain PiPhi integrations, sidecars, and widgets.",
  "type": "module",
  "bin": {
    "piphi": "dist/index.js",
    "piphi-network-create": "dist/index.js",
    "create-piphi-integration": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PiPhi-io/piphi_network_create.git"
  },
  "bugs": {
    "url": "https://github.com/PiPhi-io/piphi_network_create/issues"
  },
  "homepage": "https://github.com/PiPhi-io/piphi_network_create#readme",
  "keywords": [
    "piphi",
    "integration",
    "runtime",
    "scaffold",
    "sidecar",
    "widget"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^6.0.2"
  },
  "license": "MIT",
  "dependencies": {
    "@piphi-network/integration-doctor": "^0.2.0",
    "ajv": "^8.20.0",
    "commander": "^13.1.0",
    "enquirer": "^2.4.1",
    "fflate": "^0.8.2",
    "piphi-network-widget-sdk": "0.6.1"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.piphi.io/runtime/native-artifact-set.v1.schema.json",
  "title": "PiPhi native artifact set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "package_id", "package_version", "source_revision", "artifacts"],
  "properties": {
    "contract": {"const": "piphi.native-artifact-set.v1"},
    "package_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "package_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "runtime_contract": {"const": "piphi.runtime-http.v1"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "architecture",
          "format",
          "url",
          "digest",
          "size_bytes",
          "entrypoint",
          "signature",
          "sbom",
          "provenance"
        ],
        "properties": {
          "platform": {"enum": ["linux", "windows", "macos"]},
          "architecture": {"enum": ["amd64", "arm64"]},
          "minimum_os_version": {"type": ["string", "null"], "maxLength": 64},
          "format": {"enum": ["zip", "tar_zst"]},
          "url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1, "maximum": 4294967296},
          "entrypoint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
          },
          "signature": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "identity", "verified"],
            "properties": {
              "kind": {"enum": ["authenticode", "developer_id", "sigstore"]},
              "identity": {"type": "string", "minLength": 1, "maxLength": 256},
              "verified": {"const": true}
            }
          },
          "signature_bundle": {"type": ["string", "null"], "format": "uri", "pattern": "^https://"},
          "sbom": {"type": "string", "format": "uri", "pattern": "^https://"},
          "provenance": {"type": "string", "format": "uri", "pattern": "^https://"}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "signature": {
                  "properties": {"kind": {"const": "sigstore"}},
                  "required": ["kind"]
                }
              }
            },
            "then": {
              "required": ["signature_bundle"],
              "properties": {
                "signature_bundle": {"type": "string", "format": "uri", "pattern": "^https://"}
              }
            }
          }
        ]
      }
    }
  }
}
